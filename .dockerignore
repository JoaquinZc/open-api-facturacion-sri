# =================================================
# Docker Ignore - Carbone API
# =================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (we build inside Docker)
dist
build

# Development files
.git
.gitignore
.vscode
.idea
*.md
!README.md

# Test files
test
*.spec.ts
*.test.ts
coverage
.nyc_output

# Environment files (we pass env vars at runtime)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Data directories (mounted as volumes)
#
# `templates` NO está aquí a propósito: las plantillas del RIDE son código, se
# versionan con la aplicación y tienen que viajar en la imagen. Estaban
# excluidas y el resultado era que `/data/templates` quedaba vacío y **ningún
# RIDE se podía generar** («No se encontró ningún template con ID: ride»).
#
# Los de abajo sí son datos: los escribe la aplicación en tiempo de ejecución.
pdfs
certs

# Temp files
.temp
.tmp
*.pid
*.seed
